# VERITEXT Configuration Environment Variables
PROJECT_NAME=VERITEXT
VERSION=1.0.0
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production; SQLite fallback supported)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veritext_db
# DATABASE_URL=sqlite:///./veritext.db

# Storage Providers (local / s3)
STORAGE_PROVIDER=local
STORAGE_BASE_PATH=./storage/uploads
REPORT_STORAGE_PATH=./storage/reports
MAX_UPLOAD_SIZE_MB=25

# ML Models & Service Configuration
AI_MODEL_CONFIGURATION=VERITEXT-Stylometry-v1.4
OCR_MODEL_CONFIGURATION=tesseract-trocr-fallback
SIMILARITY_MODEL_CONFIGURATION=hybrid-shingling-cosine
